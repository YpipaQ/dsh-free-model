{
  "name": "dsh-free-model",
  "version": "3.0.0",
  "type": "module",
  "description": "dsh 插件（DeepSeek Harness / cordis bundle）· 模型接入 —— 把 CodeArts、CodeBuddy / WorkBuddy、LobsterAI、Qoder / Qoder CN、TRAE、Cline、Loomy、Raccoon、MiniMax Code、ZCode、Gemini、OfficeAce、Accio Work 十五个账号渠道接进 dsh 的模型选择器，并保留数据看板、运行日志与本地网关（含局域网中继）。上游 2.1.0 的匿名免费车道、EAC 协付车道、聚合渠道、省 Token、路由、公告/升级/热重载与独立 Web 产品已全部移除。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "test": "node scripts/test-all.mjs",
    "selftest": "node scripts/host-smoke-test.mjs",
    "channel-pack": "node scripts/build-channel-pack.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "vendor/channel-pack/pack.js",
    "vendor/channel-pack/qoder-auth-wasm.wasm",
    "vendor/channel-pack/NOTICE.md",
    "vendor/channel-pack/LICENSE",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README_EN.md",
    "SECURITY-AUDIT.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "model-access",
    "account-channels",
    "llm-provider"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YpipaQ/dsh-free-model.git"
  },
  "homepage": "https://github.com/YpipaQ/dsh-free-model#readme",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": []
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-commands": "^0.1.2-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-credentials": "^0.1.2-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
